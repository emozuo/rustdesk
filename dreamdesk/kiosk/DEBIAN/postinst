#!/bin/sh
# 建 kiosk 账户（没有口令、只能自动登录，没有 sudo），默认会话设成 DreamDesk Kiosk，开机自动登录它。
# GDM 设置只改自动登录那两行，改前把原来的两行记下（卸载时放回去，别的设置不动）。
set -e
U=kiosk
GDM=/etc/gdm3/custom.conf
STATE=/var/lib/dreamdesk-kiosk
# 本包建的账户留个记号：说明字段可能被改过，不能拿它认
OWNED=$STATE/account-created
SAVED=$STATE/gdm-autologin-orig

if [ "$1" = configure ]; then
    install -d "$STATE"
    if ! id -u "$U" >/dev/null 2>&1; then
        useradd --create-home --shell /bin/bash --comment "DreamDesk Kiosk" "$U"
        touch "$OWNED"
    elif [ ! -f "$OWNED" ]; then
        # 同名账户不是本包建的：不锁它的口令、不改它的会话
        echo "已有一个不是本包建的账户 $U，先改名或删掉它再装" >&2
        exit 1
    fi
    passwd --lock "$U" >/dev/null
    install -d -o "$U" -g "$U" "/home/$U/.config"
    # 屏蔽会弹窗口的用户级单元（首次登录向导、升级提示……，清单见该文件）；每次装 / 升级按清单重建
    M="/home/$U/.config/systemd/user"
    install -d -o "$U" -g "$U" "/home/$U/.config/systemd" "$M"
    find "$M" -maxdepth 1 -type l -lname /dev/null -delete
    grep -v -e '^#' -e '^[[:space:]]*$' /usr/share/dreamdesk-kiosk/masked-user-units | while read -r unit; do
        ln -sf /dev/null "$M/$unit"
    done
    chown -h "$U:$U" "$M"/* 2>/dev/null || true

    # 账户自己的设置库直接由本包的设置文件编出来（快捷键、锁屏，见 /usr/share/dreamdesk-kiosk/dconf）；每次装 / 升级都重编
    install -d -o "$U" -g "$U" "/home/$U/.config/dconf"
    dconf compile "/home/$U/.config/dconf/user" /usr/share/dreamdesk-kiosk/dconf
    chown "$U:$U" "/home/$U/.config/dconf/user"

    install -d /var/lib/AccountsService/users
    printf '[User]\nSession=dreamdesk-kiosk\nSystemAccount=false\n' > "/var/lib/AccountsService/users/$U"

    [ -f "$GDM" ] || install -D -m 644 /dev/null "$GDM"
    # 只在第一次装时记原来的两行（升级时现在的两行已经是本包写的）
    [ -f "$SAVED" ] || grep -E '^[[:space:]]*AutomaticLogin(Enable)?[[:space:]]*=' "$GDM" >"$SAVED" || true
    grep -q '^\[daemon\]' "$GDM" || printf '[daemon]\n' >>"$GDM"
    sed -i -e '/^[[:space:]]*AutomaticLoginEnable[[:space:]]*=/d' -e '/^[[:space:]]*AutomaticLogin[[:space:]]*=/d' "$GDM"
    sed -i "/^\[daemon\]/a AutomaticLoginEnable=true\nAutomaticLogin=$U" "$GDM"
fi
exit 0
